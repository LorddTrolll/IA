# Desenvolvimento sem Supabase: demo Dentim local com dados fictícios.
# A demonstração exige login individual; credenciais fictícias estão no README.
# Produção: defina false. Nunca publique dados reais com DEMO_MODE=true.
# Vazio usa a seleção automática segura: demo só fora de NODE_ENV=production
# e somente quando nenhuma variável Supabase foi configurada.
DEMO_MODE=

# Backend Supabase. Preencha as três para dados reais.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origem HTTPS final usada nas verificações de origem.
# Exemplo local: http://localhost:3000
APP_URL=

# Opcional: chat Grok. Sem chave, a busca documental local continua disponível.
# Defina XAI_MODEL com um modelo de chat habilitado na conta xAI.
XAI_API_KEY=
XAI_MODEL=

# Opcional, somente demo: pasta SQLite local. Padrão .data/ na raiz do projeto.
# Não usar esse armazenamento para dados reais no Render gratuito.
# DEMO_DATA_DIR=
